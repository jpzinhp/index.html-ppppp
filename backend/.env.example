# AI Website Hunter — backend environment variables
#
# O aplicativo funciona 100% em MODO GRATUITO/DEMO mesmo com estes valores
# vazios. Preencha apenas se você tiver essas chaves.

# Porta do servidor Express
PORT=4000

# Origem(ns) do frontend permitidas pelo CORS (separadas por vírgula).
CORS_ORIGIN=http://localhost:5173

# Chave da API de IA (Anthropic) usada para gerar textos do site.
# Se vazia, o backend usa o gerador local por templates (modo demo),
# que sempre funciona e nunca quebra a geração.
AI_API_KEY=
AI_API_URL=https://api.anthropic.com/v1/messages
AI_MODEL=claude-sonnet-5

# Chave da API do Pexels usada para buscar fotos ilustrativas do segmento.
# Se vazia, o backend usa imagens de placeholder locais (SVG), deixando
# isso claro na resposta (isPlaceholder: true).
PEXELS_API_KEY=
